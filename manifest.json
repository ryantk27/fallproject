{
    "manifest_version":3, 
    "name":"hook", 
    "version":"1.0.0",
    "content_scripts": [
        {
            "matches":["<all_urls>"],
            "js":["content.js"]
        }
    ],
    "background":{
        "service_workers":"background.js"
    },
    "action":{
        "default_popup":"popup.html",
        "default_title":"hook"
    },
    "permissions":["tabs"]
}