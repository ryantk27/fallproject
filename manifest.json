{
    "manifest_version":3, 
    "name":"hook", 
    "version":"1.0.0",
    "content_scripts": [
        {
            "matches":["<all_urls>"],
            "js":["content/content.js"]
        }
    ],
    "background":{
        "service_worker":"background/background.js"
    },
    "action":{
        "default_popup":"popup/popup.html",
        "default_title":"hook"
    },
    "permissions":["tabs","activeTab", "scripting"]
}